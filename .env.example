# --- Telegram bot from @BotFather ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user ids of admins (always subscribed)
# Find your id via @userinfobot
ADMIN_IDS=123456789

# --- Channels to monitor (no @ prefix, comma-separated) ---
CHANNELS=kpszsu,kyiv_alarm,war_monitor

# Channel display labels (parallel to CHANNELS, comma-separated)
# Used only for human-friendly messages
CHANNEL_LABELS=Повітряні Сили ЗСУ,Тривога Київ,War Monitor

# --- Poller ---
# Polling interval in idle (seconds, default 60)
POLL_INTERVAL_IDLE=60
# Polling interval when threat level >= 2 (seconds, default 20)
POLL_INTERVAL_ACTIVE=20

# Min threat level to push DM alerts (default 3 = "Висока")
ALERT_MIN_LEVEL=3
# Cooldown between push alerts to same user (seconds, default 600 = 10min)
ALERT_COOLDOWN_SEC=600

# --- Storage ---
# Optional Postgres (Supabase) — leave blank for local SQLite
# DATABASE_URL=postgresql://...
# DB_PATH=./threat.db

# Timezone for display (default Europe/Kyiv)
TZ=Europe/Kyiv

# --- Webhook (production on Render) ---
# Leave blank to run in polling mode (local dev)
# WEBHOOK_BASE_URL=https://air-threat-bot.onrender.com
# WEBHOOK_SECRET_PATH=/tg/webhook
PORT=10000
